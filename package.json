{
  "name": "horizon-bound-beta",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./assets/app.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./assets/app.css --watch",
    "generate:fallback-images": "node scripts/create-fallback-images.mjs",
    "generate:pages": "node scripts/create-fallback-images.mjs && node scripts/generate-pages.mjs --base=/fun-app --origin=https://hamiltondan20-sys.github.io --out=. --min-words=350",
    "extract:css": "node scripts/extract-inline-css.mjs",
    "sitemap": "node scripts/create-fallback-images.mjs && node scripts/generate-pages.mjs --base=/fun-app --origin=https://hamiltondan20-sys.github.io --out=. --min-words=350",
    "check:release": "node scripts/create-fallback-images.mjs && node scripts/generate-pages.mjs --base=/fun-app --origin=https://hamiltondan20-sys.github.io --out=. --min-words=350 && node scripts/check-release.js"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "tailwindcss": "^3.4.17"
  }
}
